# ================= 邮箱接收配置（IMAP） =================
# 复制本文件为 .env（.env 已被 .gitignore 忽略，请勿提交）到脚本同级的技能目录，
# 或放到当前工作目录 / 用户主目录，脚本会自动查找。

# 邮箱服务器地址
#   QQ 邮箱     : imap.qq.com
#   网易163     : imap.163.com
#   网易企业邮箱 : 见企业开通邮件（形如 smtphz.qiye.163.com）
#   Gmail       : imap.gmail.com
#   Outlook.com : outlook.office365.com
IMAP_HOST=imap.qq.com

# IMAP 端口：SSL 用 993；非 SSL（STARTTLS）用 143
IMAP_PORT=993

# 是否使用 SSL（true / false）
IMAP_SSL=true

# 邮箱账号（完整邮箱地址）
EMAIL_USER=your_email@example.com

# 密码 / 授权码 / 应用专用密码
#   QQ / 163 / 网易企业邮箱: 使用「授权码」或 IT 分配的专用密码，而非登录密码
#   Gmail / Outlook.com / Hotmail / MSN: 使用「应用专用密码」（普通登录密码已不可用）
EMAIL_PASSWORD=your_password_or_authorization_code

# 默认收取的文件夹（一般用 INBOX）
IMAP_MAILBOX=INBOX

# 默认每次最多拉取的邮件数量
EMAIL_FETCH_LIMIT=10

# 可选：默认只拉取最近 N 天的邮件（0 表示不限制，可用 --days 覆盖）
EMAIL_FETCH_DAYS=0
