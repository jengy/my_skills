# ================= 邮箱发送配置（SMTP） =================
# 复制本文件为 .env（.env 已被 .gitignore 忽略，请勿提交）。
# 与 email-receive 共用 EMAIL_USER / EMAIL_PASSWORD，可放同一个 .env。

# SMTP 服务器地址
#   QQ 邮箱     : smtp.qq.com
#   网易163     : smtp.163.com
#   网易企业邮箱 : 见开通邮件（如 smtphz.qiye.163.com）
#   Gmail       : smtp.gmail.com
#   Outlook.com : smtp-mail.outlook.com
#   Office 365  : smtp.office365.com
SMTP_HOST=smtp.qq.com

# 端口：SSL 用 465；STARTTLS 用 587
SMTP_PORT=465

# 是否直连 SSL（true / false）
SMTP_SSL=true

# 是否使用 STARTTLS（配合端口 587）：SMTP_SSL=false + SMTP_STARTTLS=true
SMTP_STARTTLS=false

# 邮箱账号（完整邮箱地址，与收信共用）
EMAIL_USER=your_email@example.com

# 密码 / 授权码 / 应用专用密码（QQ/163 用授权码，Gmail/微软用应用密码）
EMAIL_PASSWORD=your_password_or_authorization_code

# 可选：发件人显示地址（默认同 EMAIL_USER）
EMAIL_FROM=

# 可选：发件人显示名称（如 "Zhang San"）
EMAIL_FROM_NAME=

# 可选：回复地址
EMAIL_REPLY_TO=
